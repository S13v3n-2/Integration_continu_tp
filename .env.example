# Copier ce fichier en .env puis adapter les valeurs (le .env n'est jamais commite)

# PostgreSQL (lu aussi par docker compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=transactions
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# S3 local (seaweedfs), les cles sont libres en local
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=local
S3_SECRET_KEY=local-secret
S3_BUCKET=transactions
S3_REGION=us-east-1

# Simulation d'un bug d'insertion : nombre d'echecs avant que ca passe (0 = desactive)
# PIPELINE_ECHEC_INSERTION=2
